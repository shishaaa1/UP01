<UserControl x:Class="TaigerDesktop.Pages.ViewLogs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaigerDesktop.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100"
             Background="Transparent">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель фильтров -->
        <Border Background="{StaticResource WhiteBrush}" 
                CornerRadius="12" 
                Padding="20" 
                Margin="0,0,0,20"
                Grid.Row="0"
                BorderBrush="{StaticResource SoftLavenderBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="ID пользователя:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"
                           Foreground="{StaticResource DarkPurpleBrush}"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="UserIdFilter" 
                         Width="100" 
                         Height="36"
                         Margin="0,0,15,0"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         PreviewTextInput="UserIdFilter_PreviewTextInput"/>
                <Button Content="Показать логи" 
                        Click="LoadFilteredLogs"
                        Background="{StaticResource SoftLavenderBrush}"
                        Foreground="{StaticResource DarkPurpleBrush}"
                        Height="36"
                        Padding="15,0"
                        Margin="0,0,15,0"
                        Cursor="Hand"/>
                <Button Content="Показать все логи" 
                        Click="LoadAllLogs"
                        Background="{StaticResource LightBackgroundBrush}"
                        BorderBrush="{StaticResource SoftLavenderBrush}"
                        BorderThickness="1"
                        Foreground="{StaticResource DarkPurpleBrush}"
                        Height="36"
                        Padding="15,0"
                        Cursor="Hand"/>
                <Button 
                        Click="RefreshLogs"
                        Background="{StaticResource WhiteBrush}"
                        BorderBrush="{StaticResource SoftLavenderBrush}"
                        BorderThickness="1"
                        Foreground="{StaticResource DarkPurpleBrush}"
                        Height="36"
                        Padding="15,0"
                        Margin="15,0,0,0"
                        Cursor="Hand">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0"/>
                            <TextBlock Text="Обновить"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Border>

        <!-- Таблица логов -->
        <DataGrid x:Name="LogsGrid" 
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowDetailsVisibilityMode="Collapsed"
                  SelectionMode="Single"
                  Background="{StaticResource WhiteBrush}"
                  BorderBrush="{StaticResource SoftLavenderBrush}"
                  BorderThickness="1"
                  RowHeight="45"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeRows="False"
                  ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="ID Пользователя" Binding="{Binding UserId}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Действие" Binding="{Binding ActionDisplay}" Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="Сущность" Binding="{Binding Entity}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="250" IsReadOnly="True"/>
                <DataGridTextColumn Header="Дата/Время" Binding="{Binding FormattedTime}" Width="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="IP-адрес" Binding="{Binding IpAddress}" Width="130" IsReadOnly="True"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource SoftLavenderBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource SoftLavenderBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource DarkPurpleBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="12,10"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SoftLavenderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>

        <!-- Загрузка -->
        <Border x:Name="LoadingOverlay" 
                Grid.RowSpan="2"
                Background="#CCFFFFFF"
                CornerRadius="12"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Загрузка логов..." 
                           FontSize="18"
                           Foreground="{StaticResource DarkPurpleBrush}"
                           Margin="0,0,0,10"/>
                <ProgressBar Width="200" 
                             Height="10" 
                             IsIndeterminate="True"
                             Foreground="{StaticResource SoftLavenderBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
