<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Иконка знака -->
        <ImageView
            android:id="@+id/ivSign"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerInside"
            android:contentDescription="sign icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvDescription"/>

        <!-- Название знака -->
        <TextView
            android:id="@+id/tvSignName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Овен"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222"
            app:layout_constraintStart_toEndOf="@id/ivSign"
            app:layout_constraintTop_toTopOf="@id/ivSign"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="12dp"/>

        <!-- Текст прогноза -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Текст гороскопа..."
            android:textSize="14sp"
            android:textColor="#555"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/ivSign"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>